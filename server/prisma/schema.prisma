generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model FlightSearch {
  id               Int           @id @default(autoincrement())
  departureCode    String        @db.Char(3)
  arrivalCode      String        @db.Char(3)
  outboundDate     DateTime      @db.Date
  adults           Int           @default(1)
  travelClass      Int           @default(1)
  currency         String        @default("VND") @db.Char(3)
  fetchedAt        DateTime      @default(now())
  expiresAt        DateTime
  lowestPrice      Int?
  priceLevel       String?       @db.VarChar(20)
  typicalPriceLow  Int?
  typicalPriceHigh Int?
  offers           FlightOffer[]

  @@index([departureCode, arrivalCode, outboundDate, adults, travelClass, currency, fetchedAt])
}

model FlightOffer {
  id                   Int             @id @default(autoincrement())
  searchId             Int
  search               FlightSearch    @relation(fields: [searchId], references: [id], onDelete: Cascade)
  category             String          @db.VarChar(10)
  position             Int
  price                Int
  totalDurationMinutes Int?
  segments             FlightSegment[]

  @@unique([searchId, category, position])
}

model FlightSegment {
  id              Int         @id @default(autoincrement())
  offerId         Int
  offer           FlightOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  position        Int
  flightNumber    String      @db.VarChar(20)
  airlineName     String      @db.VarChar(120)
  departureCode   String      @db.Char(3)
  arrivalCode     String      @db.Char(3)
  departureTime   DateTime    @db.DateTime(0)
  arrivalTime     DateTime    @db.DateTime(0)
  durationMinutes Int?

  @@unique([offerId, position])
}

enum FlightStatus {
  SCHEDULED
  BOARDING
  DEPARTED
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum TicketStatus {
  ISSUED
  USED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PassengerGender {
  MALE
  FEMALE
}

enum UserRole {
  ADMIN
  CUSTOMER
  AIRLINE_FLIGHT_MANAGER
  AIRLINE_SALES_MANAGER
}

enum AccountStatus {
  ACTIVE
  LOCKED
}

enum AirlineStatus {
  ACTIVE
  LOCKED
}

enum FlightSaleStatus {
  ON_SALE
  HIDDEN
}

enum PaymentReviewStatus {
  NONE
  NEEDS_REVIEW
  RESOLVED
}

model Airline {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(10)
  name      String   @db.VarChar(120)
  status    AirlineStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  flights Flight[]
  users   User[]
}

model User {
  id           Int           @id @default(autoincrement())
  name         String        @db.VarChar(120)
  email        String        @unique @db.VarChar(255)
  passwordHash String        @db.VarChar(255)
  role         UserRole      @default(CUSTOMER)
  status       AccountStatus @default(ACTIVE)
  airlineId    Int?
  phone        String?       @db.VarChar(20)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  airline   Airline?      @relation(fields: [airlineId], references: [id], onDelete: Restrict)
  sessions  AuthSession[]
  bookings  Booking[]
  auditLogs AuditLog[]

  @@index([airlineId, role, status])
}

model AuthSession {
  id        String   @id @db.Char(64)
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  requestId  String?  @unique @db.VarChar(64)
  actorId    Int
  action     String   @db.VarChar(80)
  entityType String   @db.VarChar(80)
  entityId   String   @db.VarChar(80)
  reason     String?  @db.VarChar(1000)
  before     Json?
  after      Json?
  result     String   @default("SUCCESS") @db.VarChar(20)
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model Flight {
  id            Int          @id @default(autoincrement())
  flightNumber  String       @db.VarChar(20)
  airlineId     Int
  departureCode String       @db.Char(3)
  arrivalCode   String       @db.Char(3)
  departureTime DateTime     @db.DateTime(0)
  arrivalTime   DateTime     @db.DateTime(0)
  capacity      Int
  basePrice     Int
  status        FlightStatus @default(SCHEDULED)
  saleStatus    FlightSaleStatus @default(ON_SALE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  airline      Airline       @relation(fields: [airlineId], references: [id], onDelete: Restrict)
  bookings     Booking[] @relation("OutboundBookings")
  returnBookings Booking[] @relation("ReturnBookings")
  tickets      Ticket[]
  pricingRules PricingRule[]

  @@index([departureCode, arrivalCode, departureTime, status])
  @@index([airlineId, departureTime])
}

model Booking {
  id          Int           @id @default(autoincrement())
  bookingCode String        @unique @default(cuid()) @db.VarChar(30)
  flightId    Int
  returnFlightId Int?
  outboundUnitPrice Int?
  returnUnitPrice Int?
  userId      Int?
  contactName String        @db.VarChar(120)
  contactEmail String?      @db.VarChar(255)
  contactPhone String?      @db.VarChar(20)
  totalAmount Int
  status      BookingStatus @default(PENDING)
  expiresAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  flight     Flight     @relation("OutboundBookings", fields: [flightId], references: [id], onDelete: Restrict)
  returnFlight Flight?  @relation("ReturnBookings", fields: [returnFlightId], references: [id], onDelete: Restrict)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  passengers Passenger[]
  payments   Payment[]

  @@index([flightId, status])
  @@index([returnFlightId, status])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model Passenger {
  id             Int      @id @default(autoincrement())
  bookingId      Int
  fullName       String   @db.VarChar(120)
  documentNumber String?  @db.VarChar(50)
  gender         PassengerGender?
  dateOfBirth    DateTime? @db.Date
  nationality    String?  @db.VarChar(80)
  createdAt      DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  tickets Ticket[]

  @@index([bookingId])
}

model Ticket {
  id             Int          @id @default(autoincrement())
  passengerId    Int
  flightId       Int
  ticketCode     String       @unique @default(cuid()) @db.VarChar(30)
  qrToken        String       @unique @default(cuid()) @db.VarChar(64)
  price          Int
  status         TicketStatus @default(ISSUED)
  issuedAt       DateTime     @default(now())
  usedAt         DateTime?

  passenger Passenger @relation(fields: [passengerId], references: [id], onDelete: Restrict)
  flight Flight @relation(fields: [flightId], references: [id], onDelete: Restrict)

  @@unique([passengerId, flightId])
  @@index([flightId, status])
}

model PricingRule {
  id                   Int      @id @default(autoincrement())
  flightId             Int
  minOccupancyPercent  Decimal  @db.Decimal(5, 2)
  maxOccupancyPercent  Decimal  @db.Decimal(5, 2)
  price                Int
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  flight Flight @relation(fields: [flightId], references: [id], onDelete: Cascade)

  @@index([flightId, minOccupancyPercent])
}

model Payment {
  id                    Int           @id @default(autoincrement())
  bookingId             Int
  amount                Int
  currency              String        @default("VND") @db.Char(3)
  method                String        @db.VarChar(30)
  status                PaymentStatus @default(PENDING)
  reviewStatus          PaymentReviewStatus @default(NONE)
  providerTransactionId String?       @unique @db.VarChar(120)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([bookingId, status])
}
